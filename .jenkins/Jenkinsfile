pipeline {
    agent any
    tools {
        jdk "jdk-25"
    }

    environment {
        ORG_GRADLE_PROJECT_BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Clean') {
            steps {
                echo 'Cleaning Project'
                sh 'chmod +x gradlew'
                sh './gradlew clean'
            }
        }

        stage('Build') {
            steps {
                sh './gradlew test validatePlugins'
            }
        }

        stage('Publish Maven') {
            when {
                buildingTag()
            }
            steps {
                script {
                    if (!env.TAG_NAME?.trim()) {
                        error 'TAG_NAME is not set; refusing to publish without a tag version.'
                    }
                }
                withCredentials([
                    string(
                        credentialsId: 'java-formatting-maven-deploy-dir',
                        variable: 'ORG_GRADLE_PROJECT_DEPLOY_DIR'
                    )
                ]) {
                    sh "./gradlew publish -PVERSION=${env.TAG_NAME}"
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'build/test-results/**/*.xml'
        }
    }
}
