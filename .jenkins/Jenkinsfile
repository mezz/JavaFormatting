pipeline {
    agent any
    tools {
        jdk "jdk-17"
    }

    stages {
        stage('Clean') {
            when {
                anyOf {
                    branch 'main'
                    buildingTag()
                }
            }
            steps {
                echo 'Cleaning Project'
                sh 'chmod +x gradlew'
                sh './gradlew clean'
            }
        }

        stage('Build') {
            when {
                branch 'main'
            }
            steps {
                sh './gradlew check'
            }
        }

        stage('Publish Maven') {
            when {
                buildingTag()
            }
            steps {
                script {
                    if (!env.TAG_NAME?.trim()) {
                        error 'TAG_NAME is not set; refusing to publish without a tag version.'
                    }
                    if (!env.local_maven_url?.trim() && !env.MAVEN_DEPLOY_DIR?.trim() && !env.local_maven?.trim()) {
                        error 'Jared Maven environment is not set; expected local_maven_url, MAVEN_DEPLOY_DIR, or local_maven.'
                    }
                }
                sh './gradlew check publish -PVERSION="$TAG_NAME"'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'build/test-results/**/*.xml'
        }
    }
}
