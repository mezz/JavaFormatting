pipeline {
    agent any
    tools {
        jdk "jdk-17"
    }
    environment {
        RELEASE_TAG = ''
    }

    stages {
        stage('Clean') {
            when {
                branch 'main'
            }
            steps {
                echo 'Cleaning Project'
                sh 'chmod +x gradlew'
                sh './gradlew clean'
            }
        }

        stage('Build') {
            when {
                branch 'main'
            }
            steps {
                sh './gradlew check'
            }
        }

        stage('Resolve Release Tag') {
            when {
                branch 'main'
            }
            steps {
                script {
                    sh 'git fetch --tags --force'
                    env.RELEASE_TAG = sh(
                        script: '''
                            head_commit="$(git rev-parse HEAD)"
                            git for-each-ref --sort=-v:refname --format='%(refname:short)' 'refs/tags/v[0-9]*.[0-9]*.[0-9]*' |
                                while IFS= read -r tag; do
                                    tag_commit="$(git rev-list -n 1 "$tag")"
                                    if [ "$tag_commit" = "$head_commit" ]; then
                                        echo "$tag"
                                        break
                                    fi
                                done
                        ''',
                        returnStdout: true
                    ).trim()
                    if (env.RELEASE_TAG) {
                        echo "Release tag found on HEAD: ${env.RELEASE_TAG}"
                    } else {
                        echo 'No release tag found on HEAD; publish will be skipped.'
                    }
                }
            }
        }

        stage('Publish Maven') {
            when {
                allOf {
                    branch 'main'
                    expression {
                        return env.RELEASE_TAG?.trim() ? true : false
                    }
                }
            }
            steps {
                script {
                    if (!env.local_maven_url?.trim() && !env.MAVEN_DEPLOY_DIR?.trim() && !env.local_maven?.trim()) {
                        error 'Jared Maven environment is not set; expected local_maven_url, MAVEN_DEPLOY_DIR, or local_maven.'
                    }
                }
                sh './gradlew check publish -PVERSION="$RELEASE_TAG"'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'build/test-results/**/*.xml'
        }
    }
}
